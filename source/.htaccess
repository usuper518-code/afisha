RewriteEngine On

# Блокировка доступа к скрытым файлам
RedirectMatch 403 /\..*$

# Сессии, счётчики, логи, схема, крон, шаблоны и библиотеки не отдаются по HTTP
RewriteRule ^(storage|logs|sql|cron|templates)(/|$) - [F,L]
RewriteRule ^api/vendor(/|$) - [F,L]

# Весь API идёт во фронт-контроллер. Соседние .php не исполняются.
# END не даёт следующему правилу закрыть уже переписанный index.php.
RewriteRule ^api(/|$) api/index.php [E=API_FRONT:1,END]

# Прочие скрипты по HTTP закрыты, в том числе файлы в uploads.
RewriteCond %{ENV:REDIRECT_API_FRONT} !^1$
RewriteRule \.(php|phtml|phar|phps)$ - [F,L]

# Каталог без своей страницы не показываем списком
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^ - [F,L]

# Статические файлы и существующие папки не трогаем
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Ошибка 404
ErrorDocument 404 /404.html
